{
  "name": "wildforge",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:browser": "vite build && node scripts/qa-browser.mjs",
    "qa:m1": "vite build && node scripts/qa-m1.mjs",
    "qa:m2": "vite build && node scripts/qa-m2.mjs",
    "qa:m3": "vite build && node scripts/qa-m3.mjs",
    "qa:m3-full": "vite build && node scripts/qa-m3-full.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
